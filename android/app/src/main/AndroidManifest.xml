<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <!-- Daily reminders that run on the phone (morning / night, set in Settings) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <application
        android:label="Espere"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share a payment receipt (text or screenshot) from a UPI app to Espere -->
            <intent-filter android:label="Add to Espere">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter android:label="Add to Espere">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- Deep Linking -->
            <intent-filter
                android:autoVerify="true">
                <action
                    android:name="android.intent.action.VIEW"/>
                <category
                    android:name="android.intent.category.DEFAULT"/>
                <category
                    android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="http"/>
                <data
                    android:scheme="https"/>
                <data
                    android:host="espere.in"/>
                <data
                    android:pathPrefix="/accounts/verify/"/>
                <data
                    android:pathPrefix="/accounts/register/"/>
                <data
                    android:pathPrefix="/invite/"/>
                <data
                    android:pathPrefix="/add_friend/"/>
                <data
                    android:pathPrefix="/split/invitations"/>
                <data
                    android:pathPrefix="/transaction/add"/>
                <data
                    android:pathPrefix="/transactions"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_icon_color"/>
        <!-- Quick Add Expense Home-Screen Widget Provider -->
        <receiver
            android:name=".QuickAddWidgetProvider"
            android:label="Quick Add Expense"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action
                    android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info"/>
        </receiver>

        <!-- Lightweight Dialog Activities without opening full app -->
        <activity
            android:name=".QuickAmountDialogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.QuickAddSheet"
            android:windowSoftInputMode="stateVisible|adjustResize"/>

        <activity
            android:name=".QuickNoteDialogActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickAddDialog"
            android:windowSoftInputMode="stateVisible|adjustResize"/>

        <!-- On-device text recognition for shared receipt screenshots: ask Play services to
             download the model at install time, so the first scan also works offline. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr"/>

        <!-- Daily reminders: fires them and sets them again after a reboot, an update or
             a clock change. -->
        <receiver
            android:name=".reminders.DailyReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.espere_app.DAILY_REMINDER"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Auto-track payments: reads payment notifications from allow-listed UPI/bank
             apps on device. Only the system (holding BIND_NOTIFICATION_LISTENER_SERVICE)
             can bind it; it does nothing until the user opts in inside the app. -->
        <service
            android:name=".autocapture.PaymentNotificationListener"
            android:exported="true"
            android:label="@string/auto_capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <category
                android:name="android.intent.category.BROWSABLE"/>
            <data
                android:scheme="https"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <category
                android:name="android.intent.category.BROWSABLE"/>
            <data
                android:scheme="http"/>
        </intent>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>