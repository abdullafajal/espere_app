<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_app_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_app_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Espere"
            android:textColor="@color/quick_widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_open_quick_add"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spent today"
            android:textColor="@color/quick_widget_text_secondary"
            android:maxLines="1"
            android:textSize="11sp"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_today_spend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textColor="@color/quick_widget_text_primary"
            android:maxLines="1"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_total_spend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textColor="@color/quick_widget_text_secondary"
            android:maxLines="1"
            android:textSize="11sp"
            android:ellipsize="end"
                    android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_btn_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
