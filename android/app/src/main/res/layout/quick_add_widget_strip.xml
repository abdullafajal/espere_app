<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/btn_open_quick_add"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_pill_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Spent today"
                android:textColor="@color/widget_text_2"
                android:textSize="11sp"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_today_spend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="₹0.00"
                android:textColor="@color/widget_text_1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeStepGranularity="1sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_btn_plus"
        android:contentDescription="Add expense"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/widget_glass_circle">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus_hero" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
