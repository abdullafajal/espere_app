<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: add, today's spend, list - frosted Samsung-style widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fr_widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/widget_btn_plus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/fr_circle"
        android:contentDescription="Add expense">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_plus"
            android:tint="@color/ou_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Today"
            android:textColor="@color/fr_text_2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_today_spend"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="₹0"
            android:textColor="@color/fr_text_1"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_btn_app"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/fr_circle"
        android:contentDescription="View transactions">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_list"
            android:tint="@color/ou_accent" />
    </FrameLayout>
</LinearLayout>
