<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <!-- Floating bottom sheet -->
    <LinearLayout
        android:tag="panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/dialog_rounded_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Grab handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/widget_handle" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
        android:tag="pill"
                android:id="@+id/btn_header_back"
        android:contentDescription="Back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_circle_tonal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/widget_text_2"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_step_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP 1 OF 4"
                    android:textColor="@color/widget_accent_ink"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                    android:layout_marginTop="2dp"
                    android:text="Enter Amount"
                    android:textColor="@color/widget_text_1"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
        android:tag="pill"
                android:id="@+id/btn_dialog_close"
        android:contentDescription="Close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_circle_tonal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/widget_text_2"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>

        <!-- Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/dot_step_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/quick_widget_progress_active" />
            <FrameLayout
                android:id="@+id/dot_step_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/quick_widget_progress_inactive" />
            <FrameLayout
                android:id="@+id/dot_step_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/quick_widget_progress_inactive" />
            <FrameLayout
                android:id="@+id/dot_step_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/quick_widget_progress_inactive" />
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ═════════ STEP 1: AMOUNT ═════════ -->
            <LinearLayout
                android:id="@+id/page_step_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="How much did you spend?"
                    android:textColor="@color/widget_text_2"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/step1_currency_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹"
                        android:textColor="@color/widget_accent_ink"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/step1_amount_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:hint="0"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLength="10"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/widget_text_1"
                        android:textColorHint="@color/widget_text_2"
                        android:textSize="56sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
        android:tag="pill"
                        android:id="@+id/step1_chip_100"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/quick_widget_chip"
                        android:gravity="center"
                        android:text="+100"
                        android:textColor="@color/widget_text_1"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
        android:tag="pill"
                        android:id="@+id/step1_chip_500"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/quick_widget_chip"
                        android:gravity="center"
                        android:text="+500"
                        android:textColor="@color/widget_text_1"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
        android:tag="pill"
                        android:id="@+id/step1_chip_1000"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/quick_widget_chip"
                        android:gravity="center"
                        android:text="+1k"
                        android:textColor="@color/widget_text_1"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
        android:tag="pill"
                        android:id="@+id/step1_chip_2000"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/quick_widget_chip"
                        android:gravity="center"
                        android:text="+2k"
                        android:textColor="@color/widget_text_1"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
        android:tag="btn"
                    android:id="@+id/step1_btn_next"
        android:contentDescription="Continue"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/quick_widget_action_btn"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue"
                        android:textColor="@color/widget_on_hero"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ STEP 2: CATEGORY ═════════ -->
            <LinearLayout
                android:id="@+id/page_step_category"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
        android:tag="accent"
                    android:id="@+id/step2_amount_subtext"
                    android:layout_width="wrap_content"
                android:layout_gravity="start"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip_lime"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Amount: ₹0"
                    android:textColor="@color/widget_on_hero"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Choose a category"
                    android:textColor="@color/widget_text_1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Search (shown when there are many categories) -->
                <LinearLayout
                    android:id="@+id/step2_search_box"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/quick_widget_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:tag="pill"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/widget_text_2" />

                    <EditText
                        android:id="@+id/step2_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search categories"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_1"
                        android:textColorHint="@color/widget_text_2"
                        android:textSize="15sp" />

                    <FrameLayout
                        android:id="@+id/step2_search_clear"
        android:contentDescription="Clear search"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_close"
                            android:tint="@color/widget_text_2" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Scrolls when there are more categories; the third row peeks out and the bottom fades as a cue -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="10dp"
                    android:fadingEdgeLength="32dp"
                    android:overScrollMode="ifContentScrolls"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <GridLayout
                        android:id="@+id/step2_category_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4" />
                </ScrollView>

                <TextView
                    android:id="@+id/step2_more_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Scroll for more categories"
                    android:textColor="@color/widget_text_2"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/step2_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="No category found"
                    android:textColor="@color/widget_text_2"
                    android:textSize="14sp"
                    android:visibility="gone" />

                                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
        android:tag="pill"
                        android:id="@+id/step2_btn_back"
        android:contentDescription="Back"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/widget_circle_tonal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_back"
                            android:tint="@color/widget_text_2"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <LinearLayout
        android:tag="btn"
                        android:id="@+id/step2_btn_next"
        android:contentDescription="Continue"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_widget_action_btn"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue"
                            android:textColor="@color/widget_on_hero"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ STEP 3: PAYMENT ═════════ -->
            <LinearLayout
                android:id="@+id/page_step_payment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
        android:tag="accent"
                    android:id="@+id/step3_summary_subtext"
                    android:layout_width="wrap_content"
                android:layout_gravity="start"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip_lime"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="₹0 • Food"
                    android:textColor="@color/widget_on_hero"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="How did you pay?"
                    android:textColor="@color/widget_text_1"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
        android:tag="pill"
                        android:id="@+id/step3_pay_cash"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/quick_widget_item_normal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/step3_pay_cash_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pay_cash"
                            android:tint="@color/widget_text_1" />

                        <TextView
                            android:id="@+id/step3_pay_cash_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Cash"
                            android:textColor="@color/widget_text_1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/step3_pay_cash_check"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/widget_accent_ink"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
        android:tag="pill"
                        android:id="@+id/step3_pay_upi"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/quick_widget_item_selected"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/step3_pay_upi_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pay_upi"
                            android:tint="@color/widget_accent_ink" />

                        <TextView
                            android:id="@+id/step3_pay_upi_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="UPI"
                            android:textColor="@color/widget_accent_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/step3_pay_upi_check"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/widget_accent_ink"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
        android:tag="pill"
                        android:id="@+id/step3_pay_card"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/quick_widget_item_normal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/step3_pay_card_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pay_card"
                            android:tint="@color/widget_text_1" />

                        <TextView
                            android:id="@+id/step3_pay_card_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Card"
                            android:textColor="@color/widget_text_1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/step3_pay_card_check"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/widget_accent_ink"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
        android:tag="pill"
                        android:id="@+id/step3_pay_bank"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/quick_widget_item_normal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/step3_pay_bank_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_pay_bank"
                            android:tint="@color/widget_text_1" />

                        <TextView
                            android:id="@+id/step3_pay_bank_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Bank"
                            android:textColor="@color/widget_text_1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/step3_pay_bank_check"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_check"
                            android:tint="@color/widget_accent_ink"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
        android:tag="pill"
                        android:id="@+id/step3_btn_back"
        android:contentDescription="Back"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/widget_circle_tonal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_back"
                            android:tint="@color/widget_text_2"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <LinearLayout
        android:tag="btn"
                        android:id="@+id/step3_btn_next"
        android:contentDescription="Continue"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/quick_widget_action_btn"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Continue"
                            android:textColor="@color/widget_on_hero"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ STEP 4: REVIEW & SAVE ═════════ -->
            <LinearLayout
                android:id="@+id/page_step_notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
        android:tag="block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_hero_block"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="You're adding"
                        android:textColor="@color/widget_on_hero"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/step4_summary_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="₹150.00"
                        android:textColor="@color/widget_on_hero"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/step4_summary_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.8"
                        android:text="• Food • UPI"
                        android:textColor="@color/widget_on_hero"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
        android:tag="pill"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/quick_widget_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_edit_note"
                        android:tint="@color/widget_text_2" />

                    <EditText
                        android:id="@+id/step4_note_input"
