<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable chip (category or payment method): icon + label -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:background="@drawable/qa_chip"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/chip_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_cat_other" />

    <TextView
        android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_1"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
