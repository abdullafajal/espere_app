<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 on short screens: one card with today / this month / avg per day - frosted Samsung-style widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fr_widget_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_app_logo"
            android:tint="@color/ou_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Espere"
            android:textColor="@color/fr_text_1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_btn_app"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="View transactions">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_list"
                android:tint="@color/fr_text_1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_btn_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/fr_circle"
            android:contentDescription="Add expense"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plus"
                android:tint="@color/ou_accent" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/fr_card"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:layout_marginEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Today"
                android:textColor="@color/fr_text_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_today_spend"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="@color/fr_text_1"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/fr_divider_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="This month"
                android:textColor="@color/fr_text_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_total_spend"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="@color/fr_text_1"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/fr_divider_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Avg / day"
                android:textColor="@color/fr_text_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_avg_daily"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="@color/fr_text_1"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
